generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User is only for convenience, the app itself signs the claims if the user is logged in web2 methods
// The User *may* be the source, or the source may be the actual wallet issuing the claim directly to composedb
model User {
  id             Int      @id @default(autoincrement())
  email          String?  @unique
  passwordHash   String?
  name           String?
  authType       AuthType @default(PASSWORD)
  authProviderId String?
  emails         UserEmail[]
}

// Other addresses that are the same person as `User.email`.
//
// One human, several inboxes: a work address and a personal one, an old employer
// and a new one. Without this, signing in with the second address made a second
// LinkedTrust account, and every app behind LinkedTrust SSO keys off the OIDC
// `sub` — so the second account arrived at the dash, the CRM and Taiga as a
// stranger with none of the person's memberships (Michael Metz, IntegralMASS,
// 2026-08-28).
//
// `email` is stored lowercase and is unique across this table, so an address
// belongs to exactly one person. Sign-in resolves through here; `User.email`
// stays the primary and is the one address that goes out in OIDC userinfo, so
// downstream apps keep seeing one stable identity however the person logged in.
model UserEmail {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuthType {
  PASSWORD
  OAUTH
  GITHUB
}

enum EntityType {
  PERSON
  ORGANIZATION
  CLAIM
  IMPACT
  EVENT
  DOCUMENT
  PRODUCT
  PLACE
  UNKNOWN
  OTHER
  CREDENTIAL
}

// Derived models

// Nodes & Edges are used to return element graph to front end view

// Nodes are generated from subject, object, source of claims, and even claim itself may be a node
// these fields are useful for display
model Node {
  id        Int        @id @default(autoincrement())
  nodeUri   String     @unique // CRITICAL: nodeUri is the semantic identity in LinkedClaims
  name      String
  entType   EntityType
  descrip   String
  image     String? // image?
  thumbnail String? // thumbnail?
  claimId   Int?       // For CLAIM type nodes, links to the source claim
  edgesTo   Edge[]     @relation("edgeTo")
  edgesFrom Edge[]     @relation("edgeFrom")
  editedAt  DateTime?
  editedBy  String?
}

// NEW MODEL: All claims are nodes. Three edge types only: subject, object, source
// Edge direction: Claim node is the hub, edges point FROM claim TO its relationships
//
// Example: Person [A] has skill Python [B], validated by [C]
//   [Claim1: HAS_SKILL] --subject--> [A]
//   [Claim1: HAS_SKILL] --object--> [B]
//   [Claim1: HAS_SKILL] --source--> [GitHub]
//   [Claim2: validated] --subject--> [C]
//   [Claim2: validated] --object--> [Claim1]
//
model Edge {
  id          Int     @id @default(autoincrement())
  startNode   Node    @relation("edgeFrom", fields: [startNodeId], references: [id])
  startNodeId Int
  endNode     Node    @relation("edgeTo", fields: [endNodeId], references: [id])
  endNodeId   Int     // Non-nullable - every edge must point somewhere
  label       String  // Expected values: subject, object, source
  thumbnail   String?
  claim       Claim   @relation("edgeClaim", fields: [claimId], references: [id])
  claimId     Int

  @@unique([startNodeId, label, claimId]) // Each claim has max 1 subject, 1 object, 1 source
}

// Raw data from signed claims - generated from composedb stream of TrustClaims
// IMPORTANT: Claims are IMMUTABLE - they can be deleted but NEVER updated
// Unique constraint on (subject, issuerId, claim, sourceURI, LEFT(statement, 500))
// See migration: 20260119000000_add_claim_unique_constraint
model Claim {
  id            Int       @id @default(autoincrement())
  subject       String
  claim         String
  object        String?
  statement     String?
  effectiveDate DateTime?

  // splat ClaimSource
  sourceURI       String?
  howKnown        HowKnown?
  dateObserved    DateTime?
  digestMultibase String?
  author          String?
  curator         String?

  // splat NormalizedRating
  aspect String?
  score  Float? // -1 to 1
  stars  Int? // 0 to 5

  // splat Measure
  amt         Float?
  unit        String?
  howMeasured String?

  // splat Sharing
  intendedAudience String?
  respondAt        String?

  confidence Float?

  // signer of the original claim
  issuerId     String?
  issuerIdType IssuerIdType?

  // cid or other external address of signed claim
  claimAddress String?

  // embedded cryptographically signed version
  proof String?

  /////////////////  Below here nothing to do with actual claim ///////////////

  // specific to this database instance
  edges Edge[] @relation(name: "edgeClaim")

  // for the database record itself
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model Credential {
  id                   String    @id
  context              Json?
  type                 Json?
  issuer               Json?
  issuanceDate         DateTime?
  expirationDate       DateTime?
  credentialSubject    Json?
  proof                Json?
  sameAs               Json?
  canonicalUri         String?   @map("canonical_uri")
  name                 String?
  credentialSchema     String?   @map("credential_schema")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([canonicalUri])
  // Additional indexes created via migration 20260119100000:
  // - issuanceDate (B-tree DESC) for date filtering and recent sorting
  // - type (GIN) for JSONB array contains queries
  // - issuer (GIN) for JSONB object contains queries
  // - credential_schema (B-tree) for exact match filtering
  // - credentialSubject (GIN) for subject queries
}

model UriEntity {
  id          Int        @id @default(autoincrement())
  uri         String     @unique
  entityType  EntityType @map("entity_type")
  entityTable String     @map("entity_table")
  entityId    String     @map("entity_id")
  name        String?
  image       String?
  thumbnail   String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  
  @@index([entityType])
  @@index([entityTable, entityId])
  @@map("uri_entities")
}


// ClaimData removed - replaced by uri_entities

// this model is to store the image of the claim
model Image {
  id      Int @id @default(autoincrement())
  claimId Int  // @unique
  // claimDataId Int

  url             String
  digestMultibase String?
  metadata        Json?
  effectiveDate   DateTime
  createdDate     DateTime @default(now())
  owner           String
  signature       String

  // claimData ClaimData @relation(fields: [claimDataId], references: [id])
}

// this is for validator service
model CandidUserInfo {
  id               Int     @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  claimId          Int?    @unique
  firstName        String?
  lastName         String?
  candid_entity_id String
  email            String
  profileURL       String
  response         ResponseStatus?
}

model ValidationRequest {
  id                Int              @id @default(autoincrement())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  context           String
  validatorName     String
  validatorEmail    String
  claimId           Int
  validationClaimId Int?             @unique
  validationStatus  ValidationStatus @default(PENDING)
  response          ResponseStatus   
  rating            Int?
  validationDate    DateTime?
  statement         String?
}

enum ValidationStatus {
  PENDING
  COMPLETED
  REJECTED
  ABANDONED
}

enum IssuerIdType {
  DID
  ETH
  PUBKEY
  URL
}

enum ResponseStatus {
  GREEN // approved
  YELLOW // may wish to follow up
  GREY // we do not have any information that they should actively be rejected
  RED // should be rejected without further action.
}

enum HowKnown {
  FIRST_HAND
  SECOND_HAND
  WEB_DOCUMENT
  VERIFIED_LOGIN
  BLOCKCHAIN
  SIGNED_DOCUMENT
  PHYSICAL_DOCUMENT
  INTEGRATION
  RESEARCH
  OPINION
  OTHER
}

model AuthApp {
  id           Int      @id @default(autoincrement())
  clientId     String   @unique @map("client_id")
  clientSecret String   @map("client_secret")
  provider     String   // 'github', 'linkedin', 'google'
  appName      String?  @map("app_name")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clientId, provider])
  @@map("auth_apps")
}

// ATProto OAuth state — short-lived, used during the authorization flow
model AtprotoOAuthState {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("atproto_oauth_state")
}

// ATProto OAuth sessions — long-lived, keyed by DID, used for publishing as user
model AtprotoOAuthSession {
  key       String   @id  // DID
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("atproto_oauth_session")
}

// ── OIDC provider (LinkedTrust-as-trust-provider) ──────────────────────────
// Registered relying apps that use "Sign in with LinkedTrust" (OIDC clients).
model OidcClient {
  id            Int      @id @default(autoincrement())
  clientId      String   @unique @map("client_id")
  clientSecret  String   @map("client_secret")   // bcrypt hash; null/empty allowed for public (PKCE-only) clients
  name          String?
  redirectUris  String[] @map("redirect_uris")
  allowedScopes String[] @default(["openid", "profile", "email", "trust"]) @map("allowed_scopes")
  isPublic      Boolean  @default(false) @map("is_public") // PKCE-only, no client_secret
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("oidc_clients")
}

// Short-lived authorization codes (Authorization Code flow + PKCE). One-time use.
model OidcAuthCode {
  code                String   @id
  clientId            String   @map("client_id")
  userId              Int      @map("user_id")
  redirectUri         String   @map("redirect_uri")
  scope               String   // space-delimited granted scopes
  nonce               String?
  codeChallenge       String?  @map("code_challenge")
  codeChallengeMethod String?  @map("code_challenge_method") // 'S256'
  expiresAt           DateTime @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([expiresAt])
  @@map("oidc_auth_codes")
}

// Magic-link offers: a pending credential awaiting recipient claim.
// The raw token is emailed to the recipient; only its sha256 hash is stored.
model CredentialOffer {
  id             Int       @id @default(autoincrement())
  credentialId   String    @map("credential_id")
  tokenHash      String    @unique @map("token_hash")
  recipientName  String?   @map("recipient_name")
  recipientEmail String?   @map("recipient_email")
  issuerOrgUri   String?   @map("issuer_org_uri")
  expiresAt      DateTime? @map("expires_at")
  claimedAt      DateTime? @map("claimed_at")
  subjectUri     String?   @map("subject_uri")
  claimId        Int?      @map("claim_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([credentialId])
  @@map("credential_offers")
}
